// Windows resource file for nano-rs
// Embeds version information into the executable.
//
// nano-rs — GNU nano, Rust port
// https://github.com/faratech/nano-rs
//
// Note: no ICON resource is referenced here. Add a `1 ICON "nano.ico"` line
// only if media/nano.ico exists, otherwise the resource compile will fail.

#include <winver.h>

// Version information
VS_VERSION_INFO VERSIONINFO
FILEVERSION     0,0,10,0
PRODUCTVERSION  0,0,10,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "nano-rs contributors"
            VALUE "FileDescription",  "nano-rs — GNU nano, Rust port"
            VALUE "FileVersion",      "0.0.10"
            VALUE "InternalName",     "nano"
            VALUE "LegalCopyright",   "GNU GPLv3"
            VALUE "OriginalFilename", "nano.exe"
            VALUE "ProductName",      "nano-rs"
            VALUE "ProductVersion",   "0.0.10"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 0x04B0
    END
END
